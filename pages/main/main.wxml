<view class="container">
  <!-- 装饰背景 -->
  <view class="decoration decoration-top"></view>
  <view class="decoration decoration-bottom"></view>

  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo-container">
      <view class="tile tile-2 number-tile">2048</view>
      <view class="tile-0"></view>
    </view>
    <text class="title">经典2048</text>
    <text class="subtitle">挑战你的思维极限</text>
  </view>

  <!-- 按钮区域 -->
  <view class="button-section">
    <!-- 最高分显示 -->
    <view class="best-score" wx:if="{{bestScore > 0}}">
      <view class="best-score-label">历史最高分</view>
      <view class="best-score-value">{{bestScore}}</view>
    </view>

    <view class="last-score" wx:if="{{hasSavedGame}}">
      <view class="last-score-label">上次得分</view>
      <view class="last-score-value">{{savedScore}}</view>
    </view>

    <button class="start-btn" bindtap="continueGame">{{hasSavedGame ? '继续游戏' : '开始游戏'}}</button>
    <button class="secondary-btn" bindtap="startFreshGame" wx:if="{{hasSavedGame}}">新游戏</button>
    <button class="rank-btn" bindtap="showRankings">排行榜</button>
  </view>
</view>
