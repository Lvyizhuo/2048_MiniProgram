/* 首页样式 - 现代化设计 */
page {
  background: linear-gradient(135deg, #faf8ef 0%, #f4f1e8 100%);
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 40rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* 装饰背景 */
.decoration {
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(246, 94, 59, 0.08) 0%, rgba(246, 124, 95, 0.03) 100%);
  filter: blur(80rpx);
  z-index: 0;
}

.decoration-top {
  top: -100rpx;
  right: -100rpx;
}

.decoration-bottom {
  bottom: -100rpx;
  left: -100rpx;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  position: relative;
  z-index: 1;
}

.logo-container {
  position: relative;
  margin-bottom: 50rpx;
}

/* 2048数字方块动画 */
.number-tile {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  font-weight: bold;
  box-shadow: 0 20rpx 60rpx rgba(246, 94, 59, 0.3);
  animation: float 3s ease-in-out infinite;
  background: linear-gradient(135deg, #f65e3b 0%, #f67c5f 100%);
  color: #fff;
}

.tile-0 {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #bbada0 0%, #a89a8f 100%);
  border-radius: 20rpx;
  top: -30rpx;
  right: -50rpx;
  opacity: 0.4;
  z-index: -1;
  animation: floatReverse 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-15rpx);
  }
}

@keyframes floatReverse {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(15rpx);
  }
}

/* 标题文字 */
.title {
  font-size: 64rpx;
  font-weight: bold;
  color: #776e65;
  margin-bottom: 16rpx;
  letter-spacing: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}

.subtitle {
  font-size: 28rpx;
  color: #8f7a66;
  opacity: 0.8;
  letter-spacing: 4rpx;
}

/* 按钮区域 */
.button-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  position: relative;
  z-index: 1;
}

/* 最高分显示 */
.best-score {
  background: linear-gradient(135deg, rgba(143, 122, 102, 0.15) 0%, rgba(187, 173, 160, 0.1) 100%);
  border-radius: 20rpx;
  padding: 30rpx 60rpx;
  margin-bottom: 50rpx;
  text-align: center;
  border: 2rpx solid rgba(187, 173, 160, 0.3);
  backdrop-filter: blur(10rpx);
}

.best-score-label {
  font-size: 26rpx;
  color: #8f7a66;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.best-score-value {
  font-size: 56rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #f65e3b 0%, #f2b179 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 上次得分显示 */
.last-score {
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 24rpx 60rpx;
  margin-bottom: 30rpx;
  text-align: center;
  border: 2rpx solid rgba(187, 173, 160, 0.25);
  backdrop-filter: blur(10rpx);
}

.last-score-label {
  font-size: 24rpx;
  color: #8f7a66;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.last-score-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #776e65;
}

/* 主按钮 - 渐变效果 */
.start-btn {
  width: 520rpx;
  height: 110rpx;
  line-height: 110rpx;
  background: linear-gradient(135deg, #f65e3b 0%, #f67c5f 100%);
  color: #fff;
  font-size: 38rpx;
  font-weight: bold;
  border-radius: 55rpx;
  box-shadow: 0 20rpx 50rpx rgba(246, 94, 59, 0.35);
  border: none;
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.start-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transition: left 0.6s ease;
}

.start-btn:active {
  transform: scale(0.96);
  box-shadow: 0 10rpx 30rpx rgba(246, 94, 59, 0.3);
}

.start-btn:active::after {
  left: 100%;
}

/* 次主按钮 - 实心但更克制 */
.secondary-btn {
  width: 520rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, rgba(143, 122, 102, 0.22) 0%, rgba(187, 173, 160, 0.18) 100%);
  color: #776e65;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: 2rpx solid rgba(187, 173, 160, 0.45);
  margin-bottom: 26rpx;
  transition: all 0.3s ease;
}

.secondary-btn:active {
  transform: scale(0.96);
  background: linear-gradient(135deg, rgba(143, 122, 102, 0.28) 0%, rgba(187, 173, 160, 0.24) 100%);
}

/* 排行按钮 - 次要按钮 */
.rank-btn {
  width: 520rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: transparent;
  color: #8f7a66;
  font-size: 32rpx;
  border-radius: 50rpx;
  border: 2rpx solid #bbada0;
  transition: all 0.3s ease;
}

.rank-btn:active {
  background: rgba(143, 122, 102, 0.1);
  transform: scale(0.96);
  border-color: #8f7a66;
}
