/* 容器 - 现代化设计 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(135deg, #faf8ef 0%, #f4f1e8 100%);
  padding: 20rpx;
  padding-top: 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

.nav-spacer {
  flex: 0 0 auto;
}

/* 顶部信息区 - 优化布局 */
.header {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 16rpx;
  backdrop-filter: blur(10rpx);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  flex: 0 0 auto;
  min-width: 0;
}

.header-left-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex: 1 1 auto;
  min-width: 0;
}

.tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.tools-left {
  justify-content: flex-start;
}

/* 游戏标题 - 更紧凑 */
.game-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #776e65;
  letter-spacing: 2rpx;
  line-height: 1;
  max-width: 180rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 分数显示 - 卡片式设计 */
.scores {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  align-items: stretch;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.score-item {
  background: #bbada0;
  border-radius: 20rpx;
  padding: 14rpx 16rpx;
  text-align: center;
  min-width: 210rpx;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.12);
  border: 2rpx solid rgba(187, 173, 160, 0.35);
  position: relative;
  overflow: visible;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-current {
  background: #f65e3b;
  border-color: rgba(246, 94, 59, 0.35);
}

.score-best {
  background: #edc22e;
  border-color: rgba(237, 194, 46, 0.35);
}

.score-label {
  font-size: 20rpx;
  color: rgba(249, 246, 242, 0.95);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  font-weight: 900;
  text-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.score-value {
  font-size: 52rpx;
  font-weight: 900;
  color: #f9f6f2;
  line-height: 1.05;
  text-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.2);
  will-change: transform;
  transform: translate3d(0, 0, 0);
}

/* 分数跳动动画 */
.score-pop {
  animation: scorePop 220ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes scorePop {
  0%   { transform: translate3d(0, 0, 0) scale(1); }
  40%  { transform: translate3d(0, 0, 0) scale(1.18); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}

/* +XX 飘字 */
.score-plus {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
  pointer-events: none;
  will-change: transform, opacity;
  transform: translate3d(0, 0, 0);
  animation: scorePlusFloat 620ms ease-out both;
}

@keyframes scorePlusFloat {
  0%   { opacity: 0; transform: translate3d(0, 12rpx, 0) scale(0.9); }
  20%  { opacity: 1; }
  100% { opacity: 0; transform: translate3d(0, -34rpx, 0) scale(1.08); }
}

/* 头部按钮 - 现代化设计 */
.btn-header {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #8f7a66 0%, #7a6b5a 100%);
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(143, 122, 102, 0.3);
  transition: all 0.2s ease;
  position: relative;
  overflow: visible;
}

.btn-header:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 6rpx rgba(143, 122, 102, 0.2);
}

.btn-header .btn-icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
}

.btn-tool {
  width: 128rpx;
  height: 68rpx;
  border-radius: 22rpx;
  justify-content: center;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0.18) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(10rpx);
}

.btn-tool-text {
  font-size: 26rpx;
  font-weight: 900;
  color: #776e65;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.35);
}

.btn-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
}

.btn-badge.available {
  background: linear-gradient(135deg, #ff6fae 0%, #ff8a65 100%);
}

.btn-badge.need-ad {
  background: linear-gradient(135deg, rgba(237, 194, 46, 0.95) 0%, rgba(242, 177, 121, 0.95) 100%);
}

.badge-text {
  font-size: 20rpx;
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
}

.btn-undo,
.btn-eliminate,
.btn-menu {
  background: linear-gradient(135deg, #bbada0 0%, #a99a8f 100%);
}

/* 工具按钮单独的可爱配色 */
.btn-undo.btn-tool {
  background: linear-gradient(135deg, rgba(168, 223, 255, 0.55) 0%, rgba(255, 255, 255, 0.18) 100%);
  border-color: rgba(168, 223, 255, 0.55);
}

.btn-eliminate.btn-tool {
  background: linear-gradient(135deg, rgba(255, 204, 233, 0.55) 0%, rgba(255, 255, 255, 0.18) 100%);
  border-color: rgba(255, 204, 233, 0.55);
}

/* 特殊按钮样式 */
.btn-special {
  background: linear-gradient(135deg, #f2b179 0%, #e0a068 100%) !important;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  animation: buttonBounce 1.5s ease-in-out infinite;
  box-shadow: 0 6rpx 20rpx rgba(242, 177, 121, 0.4);
}

.btn-special.active {
  background: linear-gradient(135deg, #f59563 0%, #e58552 100%) !important;
  box-shadow: 0 0 30rpx rgba(242, 177, 121, 0.6);
}

@keyframes buttonBounce {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.08);
  }
}

/* 游戏棋盘 - 保持原有设计 */
.game-board {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 10rpx 0 20rpx 0;
  min-height: 0;
}

.grid-container {
  position: relative;
  width: 92vw;
  height: 92vw;
  max-width: 680rpx;
  max-height: 680rpx;
}

/* 背景网格 */
.grid-background {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #bbada0 0%, #a99a8f 100%);
  border-radius: 16rpx;
  padding: 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 32rpx rgba(187, 173, 160, 0.28);
}

.grid-row {
  display: flex;
  flex: 1;
  margin-bottom: 12rpx;
}

.grid-row:last-child {
  margin-bottom: 0;
}

.grid-cell {
  flex: 1;
  background-color: rgba(238, 228, 218, 0.4);
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.grid-cell:last-child {
  margin-right: 0;
}

/* 方块容器 */
.tiles-container {
  position: absolute;
  width: 100%;
  height: 100%;
  padding: 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.tile-wrapper {
  display: flex;
  flex: 1;
  margin-bottom: 12rpx;
}

.tile-wrapper:last-child {
  margin-bottom: 0;
}

/* 方块样式 - 扁平化 */
.tile {
  flex: 1;
  margin-right: 12rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 56rpx;
  font-weight: bold;
  position: relative;
  /* 更跟手：更短时长 + 干净的减速 */
  transition: transform 72ms cubic-bezier(0.2, 0, 0.2, 1),
              opacity 100ms ease-out;
  will-change: transform;
  transform: translate3d(0, 0, 0);
}

.tile.no-transition {
  transition: none !important;
}

.tile text {
  position: relative;
  z-index: 1;
}

.tile:last-child {
  margin-right: 0;
}

.tile-empty {
  opacity: 0;
}

.tile-hidden {
  opacity: 0 !important;
  visibility: hidden;
}

/* 消除模式下可选择的方块样式 */
.tile-selectable {
  cursor: pointer;
  box-shadow: 0 0 30rpx rgba(255, 105, 180, 0.7);
  border: 4rpx solid #FF69B4;
  animation: tilePulse 1s ease-in-out infinite;
}

@keyframes tilePulse {
  0%, 100% {
    box-shadow: 0 0 30rpx rgba(255, 105, 180, 0.6);
    border-color: #FF69B4;
  }
  50% {
    box-shadow: 0 0 50rpx rgba(255, 105, 180, 0.9);
    border-color: #FF1493;
  }
}

/* 数字颜色方案 - 2048 扁平色 */
.tile-2 {
  background: #eee4da;
  color: #776E65;
  font-size: 56rpx;
}

.tile-4 {
  background: #ede0c8;
  color: #776E65;
  font-size: 56rpx;
}

.tile-8 {
  background: #f2b179;
  color: #F9F6F2;
  font-size: 56rpx;
}

.tile-16 {
  background: #f59563;
  color: #F9F6F2;
  font-size: 56rpx;
}

.tile-32 {
  background: #f67c5f;
  color: #F9F6F2;
  font-size: 56rpx;
}

.tile-64 {
  background: #f65e3b;
  color: #F9F6F2;
  font-size: 56rpx;
}

.tile-128 {
  background: #edcf72;
  color: #F9F6F2;
  font-size: 52rpx;
}

.tile-256 {
  background: #edcc61;
  color: #F9F6F2;
  font-size: 52rpx;
}

.tile-512 {
  background: #edc850;
  color: #F9F6F2;
  font-size: 52rpx;
}

.tile-1024 {
  background: #edc53f;
  color: #F9F6F2;
  font-size: 48rpx;
}

.tile-2048 {
  background: #edc22e;
  color: #F9F6F2;
  font-size: 48rpx;
}

/* 更大的数字 */
.tile-4096,
.tile-8192 {
  background: #3c3a32;
  color: #F9F6F2;
  font-size: 44rpx;
}

/* ==================== 动画效果系统 ==================== */

/* 新方块生成：超调弹出，有生命力 */
.tile-new {
  animation: tileNew 220ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes tileNew {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  55% {
    transform: scale(1.13);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 合并动画：有重量感的三段回弹 */
.tile-merged {
  animation: tileMerged 200ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  z-index: 10;
}

@keyframes tileMerged {
  0%   { transform: scale(1); }
  35%  { transform: scale(1.2); }
  65%  { transform: scale(0.93); }
  100% { transform: scale(1); }
}

/* 被合并方块消失：平滑缩小淡出，自然感 */
.tile-merge-disappear {
  animation: tileMergeDisappear 140ms cubic-bezier(0.55, 0.055, 0.675, 0.19) both;
  pointer-events: none;
  z-index: 5;
}

@keyframes tileMergeDisappear {
  0%   { opacity: 0.85; transform: scale(0.95); }
  100% { opacity: 0;    transform: scale(0.5); }
}

/* Banner广告位 */
.ad-banner {
  width: 100%;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(187, 173, 160, 0.2) 0%, rgba(187, 173, 160, 0.1) 100%);
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #BBADA0;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx dashed rgba(187, 173, 160, 0.3);
}

/* 弹窗样式 - 现代化设计 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 200ms ease-out, visibility 200ms ease-out;
}

.modal-show {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4rpx);
}

.modal-content {
  position: relative;
  background: linear-gradient(135deg, #FAF8EF 0%, #F4F1E8 100%);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  width: 600rpx;
  box-sizing: border-box;
  text-align: center;
  z-index: 1001;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  will-change: transform, opacity;
  transform: translate3d(0, 0, 0);
}

.modal.modal-show .modal-content {
  animation: modalBounceIn 260ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.modal.modal-closing {
  opacity: 1;
  visibility: visible;
}

.modal.modal-closing .modal-content {
  animation: modalBounceOut 170ms cubic-bezier(0.2, 0, 0.2, 1) both;
}

@keyframes modalBounceIn {
  0%   { opacity: 0; transform: translate3d(0, 10rpx, 0) scale(0.86); }
  55%  { opacity: 1; transform: translate3d(0, 0, 0) scale(1.06); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes modalBounceOut {
  0%   { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  100% { opacity: 0; transform: translate3d(0, 8rpx, 0) scale(0.9); }
}

/* 游戏结束弹窗抖动 */
.modal.modal-show .modal-content-gameover {
  animation: modalGameOverIn 420ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes modalGameOverIn {
  0%   { opacity: 0; transform: translate3d(0, 12rpx, 0) scale(0.86); }
  55%  { opacity: 1; transform: translate3d(0, 0, 0) scale(1.05); }
  72%  { transform: translate3d(-10rpx, 0, 0) scale(1); }
  82%  { transform: translate3d(8rpx, 0, 0) scale(1); }
  92%  { transform: translate3d(-6rpx, 0, 0) scale(1); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}

/* 胜利弹窗金色光芒 */
.modal-content-win {
  overflow: hidden;
}

.win-rays {
  position: absolute;
  inset: -220rpx;
  background: repeating-linear-gradient(
    90deg,
    rgba(255, 215, 0, 0) 0,
    rgba(255, 215, 0, 0) 26rpx,
    rgba(255, 215, 0, 0.22) 26rpx,
    rgba(255, 215, 0, 0.22) 42rpx
  );
  opacity: 0.22;
  filter: blur(2rpx);
  transform: translate3d(0, 0, 0) rotate(12deg);
  will-change: transform;
  animation: raysSpin 4.2s linear infinite;
  pointer-events: none;
}

@keyframes raysSpin {
  0%   { transform: translate3d(0, 0, 0) rotate(12deg); }
  100% { transform: translate3d(0, 0, 0) rotate(372deg); }
}

.modal-content-win .modal-title,
.modal-content-win .modal-text,
.modal-content-win .modal-buttons {
  position: relative;
  z-index: 1;
}

.modal-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #776E65;
  margin-bottom: 30rpx;
}

.modal-title-win {
  background: linear-gradient(135deg, #EDC22E 0%, #E5B51D 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  font-size: 56rpx;
}

.modal-text {
  font-size: 32rpx;
  color: #776E65;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.modal-score {
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #f65e3b 0%, #f2b179 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 40rpx;
}

.modal-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.modal-btn {
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  width: 100%;
  transition: all 0.2s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #8F7A66 0%, #7A6B5A 100%);
  color: #F9F6F2;
  box-shadow: 0 8rpx 24rpx rgba(143, 122, 102, 0.3);
}

.btn-primary:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(143, 122, 102, 0.2);
}

.btn-secondary {
  background: rgba(187, 173, 160, 0.3);
  color: #8F7A66;
  border: 2rpx solid #BBADA0;
}

.btn-secondary:active {
  background: rgba(187, 173, 160, 0.5);
  transform: scale(0.96);
}

/* 菜单弹窗样式 */
.menu-content {
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  overflow: hidden;
}

.menu-list {
  margin: 20rpx 0 0;
  flex: 1;
  width: 100%;
  min-height: 0;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: flex-start;
}

.menu-item {
  box-sizing: border-box;
  width: calc(50% - 9rpx);
  padding: 22rpx 18rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.62) 100%);
  border-radius: 22rpx;
  text-align: left;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  border: 2rpx solid rgba(187, 173, 160, 0.28);
  margin-bottom: 18rpx;
}

.menu-item:nth-child(odd) {
  margin-right: 0;
}

.menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(187, 173, 160, 0.15);
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(187, 173, 160, 0.35) 0%, rgba(187, 173, 160, 0.18) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-shadow: inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-icon {
  font-size: 34rpx;
  font-weight: 900;
  color: #8f7a66;
  transform: translate3d(0, 0, 0);
}

.menu-icon.muted {
  opacity: 0.55;
}

.menu-item-text {
  display: flex;
  flex-direction: column;
  gap: 0;
  min-width: 0;
}

.menu-text {
  font-size: 30rpx;
  color: #776E65;
  font-weight: 900;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 菜单说明已移除 */

.menu-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 2rpx solid rgba(187, 173, 160, 0.18);
}

.menu-footer-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  border: none;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.menu-footer-btn:active {
  transform: scale(0.96);
  opacity: 0.8;
}

.menu-footer-back {
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(187, 173, 160, 0.35);
  color: #8f7a66;
}

.menu-footer-share {
  background: linear-gradient(135deg, rgba(237, 194, 46, 0.22) 0%, rgba(242, 177, 121, 0.2) 100%);
  border: 2rpx solid rgba(246, 124, 95, 0.35);
  color: #f67c5f;
}

/* 教程弹窗样式 */
.tutorial-content {
  padding: 40rpx;
}

.tutorial-image {
  width: 100%;
  height: 600rpx;
  margin: 30rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(187, 173, 160, 0.1);
  border-radius: 16rpx;
}

.tutorial-image image {
  max-width: 100%;
  max-height: 100%;
  border-radius: 12rpx;
}

.tutorial-indicator {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 30rpx 0;
}

.indicator-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: rgba(187, 173, 160, 0.4);
  transition: all 0.3s ease;
}

.indicator-dot.active {
  background: linear-gradient(135deg, #8F7A66 0%, #7A6B5A 100%);
  transform: scale(1.2);
}

.tutorial-buttons {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.tutorial-btn {
  flex: 1;
}

/* 消除模式提示 - 现代化设计 */
.eliminate-tip {
  position: fixed;
  top: calc(constant(safe-area-inset-top) + 22rpx);
  top: calc(env(safe-area-inset-top) + 22rpx);
  left: 50%;
  transform: translate(-50%, -18rpx);
  background: linear-gradient(135deg, rgba(246, 94, 59, 0.95) 0%, rgba(242, 177, 121, 0.95) 100%);
  color: #FFFFFF;
  padding: 26rpx 52rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease-out, visibility 0.3s ease-out, transform 0.3s ease-out;
  pointer-events: none;
  box-shadow: 0 20rpx 60rpx rgba(246, 94, 59, 0.4);
  text-align: center;
  line-height: 1.6;
}

.eliminate-tip.show {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
}

.eliminate-tip text {
  display: block;
  text-align: center;
  font-weight: 600;
}
