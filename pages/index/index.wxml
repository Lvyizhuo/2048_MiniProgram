<view class="container" catchtouchmove="preventMove">
  <!-- 自定义导航栏占位：避免内容与刘海/胶囊重叠 -->
  <view class="nav-spacer" style="height: {{navSpacerPx}}px;"></view>

  <!-- 顶部信息区 -->
  <view class="header">
    <view class="header-top">
      <view class="header-left">
        <view class="header-left-top">
          <view class="btn-header btn-menu" bindtap="toggleMenu">
            <image class="btn-icon" src="/src/pic/menu.png" mode="aspectFit"></image>
          </view>
          <text class="game-title">2048</text>
        </view>

        <view class="tools tools-left">
          <view class="btn-header btn-tool btn-undo" bindtap="undo" bindlongpress="showUndoTip">
            <text class="btn-tool-text">撤销</text>
            <view class="btn-badge {{undoCredits > 0 ? 'available' : 'need-ad'}}">
              <text class="badge-text">{{undoCredits > 0 ? undoCredits : 'AD'}}</text>
            </view>
          </view>
          <view class="btn-header btn-tool btn-eliminate {{eliminateMode ? 'btn-special active' : ''}}" bindtap="toggleEliminateMode" bindlongpress="showEliminateTip">
            <text class="btn-tool-text">消除</text>
            <view class="btn-badge {{eliminateCredits > 0 ? 'available' : 'need-ad'}}">
              <text class="badge-text">{{eliminateCredits > 0 ? eliminateCredits : 'AD'}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="header-right">
        <view class="scores">
          <view class="score-item score-current">
            <text class="score-label">当前分数</text>
            <text class="score-value {{scorePop ? 'score-pop' : ''}}">{{score}}</text>
            <view class="score-plus" wx:if="{{scorePlus && scorePlus.value > 0}}">+{{scorePlus.value}}</view>
          </view>
          <view class="score-item score-best">
            <text class="score-label">最高分</text>
            <text class="score-value">{{bestScore}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 棋盘区域 -->
  <view class="game-board" bindtouchstart="touchStart" bindtouchend="touchEnd" bindtouchcancel="touchCancel">
    <view class="grid-container">
      <!-- 背景网格 -->
      <view class="grid-background">
        <view class="grid-row" wx:for="{{grid}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="rowIndex">
          <view class="grid-cell" wx:for="{{row}}" wx:for-item="cell" wx:for-index="colIndex" wx:key="colIndex"></view>
        </view>
      </view>

      <!-- 方块层 -->
      <view class="tiles-container">
        <view class="tile-wrapper" wx:for="{{grid}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="rowIndex">
          <view
            wx:for="{{row}}"
            wx:for-item="cell"
            wx:for-index="colIndex"
            wx:key="colIndex"
            data-row="{{rowIndex}}"
            data-col="{{colIndex}}"
            bindtap="eliminateTile"
            class="tile {{disableTileTransition ? 'no-transition' : ''}} {{cell ? ('tile-' + cell) : 'tile-empty'}} {{tileAnimations[rowIndex + '-' + colIndex] ? tileAnimations[rowIndex + '-' + colIndex] : ''}} {{tilesToDisappear[rowIndex + '-' + colIndex] ? 'tile-merge-disappear' : ''}} {{hiddenNewTiles[rowIndex + '-' + colIndex] ? 'tile-hidden' : ''}} {{(eliminateMode && cell) ? 'tile-selectable' : ''}}"
            style="{{tileTransforms[rowIndex + '-' + colIndex] ? ('transform:' + tileTransforms[rowIndex + '-' + colIndex] + ';') : ''}}"
          >
            <text wx:if="{{cell}}">{{cell}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 消除模式提示 -->
  <view class="eliminate-tip {{eliminateTipVisible ? 'show' : ''}}">
    <text>消除模式已开启</text>
    <text>点击方块进行消除</text>
    <text>滑动即可退出</text>
  </view>

  <!-- 游戏结束弹窗 -->
  <view class="modal {{showGameOverModal ? 'modal-show' : ''}} {{gameOverModalClosing ? 'modal-closing' : ''}}" catchtouchmove="preventMove">
    <view class="modal-mask" bindtap="closeGameOverModal"></view>
    <view class="modal-content modal-content-gameover">
      <view class="modal-title">游戏结束</view>
      <view class="modal-text">当前得分</view>
      <view class="modal-score">{{score}}</view>
      <view class="modal-buttons">
        <button class="modal-btn btn-primary" bindtap="newGame">再来一局</button>
        <button class="modal-btn btn-secondary" bindtap="watchAdToRevive">看广告复活</button>
        <button class="modal-btn btn-secondary" bindtap="goToMain">返回主页</button>
      </view>
    </view>
  </view>

  <!-- 胜利弹窗 -->
  <view class="modal {{showWinModal ? 'modal-show' : ''}} {{winModalClosing ? 'modal-closing' : ''}}" catchtouchmove="preventMove">
    <view class="modal-mask" bindtap="continueGame"></view>
    <view class="modal-content modal-content-win">
      <view class="win-rays"></view>
      <view class="modal-title modal-title-win">你赢了！</view>
      <view class="modal-text">继续挑战更高分？</view>
      <view class="modal-buttons">
        <button class="modal-btn btn-primary" bindtap="continueGame">继续游戏</button>
        <button class="modal-btn btn-secondary" bindtap="newGame">重新开始</button>
      </view>
    </view>
  </view>

  <!-- 菜单弹窗 -->
  <view class="modal {{showMenuModal ? 'modal-show' : ''}} {{menuModalClosing ? 'modal-closing' : ''}}" catchtouchmove="preventMove">
    <view class="modal-mask" bindtap="closeMenu"></view>
    <view class="modal-content menu-content">
      <view class="modal-title">菜单</view>
      <scroll-view class="menu-list" scroll-y="true">
        <view class="menu-grid">
          <view class="menu-item" bindtap="continueGameFromMenu">
            <view class="menu-icon-wrap"><text class="menu-icon">▶</text></view>
            <view class="menu-item-text">
              <text class="menu-text">继续游戏</text>
            </view>
          </view>
          <view class="menu-item" bindtap="newGame">
            <view class="menu-icon-wrap"><text class="menu-icon">↻</text></view>
            <view class="menu-item-text">
              <text class="menu-text">新游戏</text>
            </view>
          </view>
          <view class="menu-item" bindtap="toggleSound">
            <view class="menu-icon-wrap"><text class="menu-icon {{soundEnabled ? '' : 'muted'}}">♬</text></view>
            <view class="menu-item-text">
              <text class="menu-text">{{soundEnabled ? '关闭音效' : '开启音效'}}</text>
            </view>
          </view>
          <view class="menu-item" bindtap="toggleVibration">
            <view class="menu-icon-wrap"><text class="menu-icon {{vibrationEnabled ? '' : 'muted'}}">≈</text></view>
            <view class="menu-item-text">
              <text class="menu-text">{{vibrationEnabled ? '关闭震动' : '开启震动'}}</text>
            </view>
          </view>
          <view class="menu-item" bindtap="showTutorialFromMenu">
            <view class="menu-icon-wrap"><text class="menu-icon">?</text></view>
            <view class="menu-item-text">
              <text class="menu-text">新手教程</text>
            </view>
          </view>
          <view class="menu-item" bindtap="goToMain">
            <view class="menu-icon-wrap"><text class="menu-icon">⌂</text></view>
            <view class="menu-item-text">
              <text class="menu-text">返回主页</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="menu-footer">
        <button class="menu-footer-btn menu-footer-back" bindtap="closeMenu">返回</button>
        <button class="menu-footer-btn menu-footer-share" open-type="share">分享</button>
      </view>
    </view>
  </view>

  <!-- 新手教程弹窗 -->
  <view class="modal {{showTutorialModal ? 'modal-show' : ''}} {{tutorialModalClosing ? 'modal-closing' : ''}}" catchtouchmove="preventMove">
    <view class="modal-mask" bindtap="closeTutorial"></view>
    <view class="modal-content tutorial-content">
      <view class="modal-title">新手教程</view>
      <view class="modal-text" wx:if="{{tutorialStep === 0}}">滑动屏幕移动方块，相同数字会合并。</view>
      <view class="modal-text" wx:if="{{tutorialStep === 1}}">每次移动后会生成新方块，尽量合成更大数字。</view>
      <view class="modal-text" wx:if="{{tutorialStep === 2}}">可撤销与消除方块，祝你玩得开心！</view>
      <view class="tutorial-image">
        <image wx:if="{{tutorialStep === 0}}" src="/src/pic/bug0.png" mode="aspectFit"></image>
        <image wx:if="{{tutorialStep === 1}}" src="/src/pic/bug1.png" mode="aspectFit"></image>
        <image wx:if="{{tutorialStep === 2}}" src="/src/pic/bug2.png" mode="aspectFit"></image>
      </view>
      <view class="tutorial-indicator">
        <view class="indicator-dot {{tutorialStep === 0 ? 'active' : ''}}"></view>
        <view class="indicator-dot {{tutorialStep === 1 ? 'active' : ''}}"></view>
        <view class="indicator-dot {{tutorialStep === 2 ? 'active' : ''}}"></view>
      </view>
      <view class="tutorial-buttons">
        <button class="modal-btn btn-secondary tutorial-btn" wx:if="{{tutorialStep > 0}}" bindtap="prevTutorialStep">上一步</button>
        <button class="modal-btn btn-primary tutorial-btn" bindtap="nextTutorialStep">{{tutorialStep < 2 ? '下一步' : '完成'}}</button>
      </view>
    </view>
  </view>
</view>
